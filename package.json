{
  "name": "tableau-semantics-sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "TypeScript SDK for the Salesforce Tableau Semantics Layer REST API (semantic model authoring + semantic queries)",
  "author": "javrrr",
  "repository": {
    "type": "git",
    "url": "https://github.com/javrrr/tableau-semantics-sdk.git"
  },
  "homepage": "https://github.com/javrrr/tableau-semantics-sdk#readme",
  "bugs": {
    "url": "https://github.com/javrrr/tableau-semantics-sdk/issues"
  },
  "keywords": [
    "salesforce",
    "tableau",
    "tableau-semantics",
    "semantic-layer",
    "semantic-model",
    "data-cloud",
    "analytics",
    "sdk",
    "typescript",
    "api",
    "openapi",
    "connect-api"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schemas": {
      "import": {
        "types": "./dist/schemas.d.ts",
        "default": "./dist/schemas.js"
      },
      "require": {
        "types": "./dist/schemas.d.cts",
        "default": "./dist/schemas.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "tsx scripts/merge-specs.ts && tsx scripts/generate-types.ts && tsx scripts/generate-services.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "audit": "tsx scripts/audit-spec-examples.ts",
    "typecheck": "tsc --noEmit",
    "release:check": "npm run typecheck && npm run test && npm run build",
    "release:version:patch": "npm version patch -m \"Bump package.json version to %s\"",
    "release:version:minor": "npm version minor -m \"Bump package.json version to %s\"",
    "release:version:major": "npm version major -m \"Bump package.json version to %s\"",
    "release:push": "git push origin main --follow-tags",
    "release:create": "gh release create \"v$npm_package_version\" --title \"v$npm_package_version\" --generate-notes",
    "release:run": "npm run release:check && npm run release:push && npm run release:create"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "openapi-typescript": "^7.6.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "yaml": "^2.6.1"
  },
  "license": "MIT"
}
